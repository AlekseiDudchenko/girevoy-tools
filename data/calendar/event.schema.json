{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.vsegiri.com/calendar/event.schema.json",
  "title": "Canonical kettlebell event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "startDate",
    "endDate",
    "country",
    "city",
    "organizer",
    "federations",
    "format",
    "status",
    "disciplines",
    "registrationUrl",
    "registrationDeadline",
    "organizerUrl",
    "timeZone",
    "lastChecked",
    "sequence",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "country": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "city": {
      "type": "string"
    },
    "organizer": {
      "type": "string",
      "minLength": 1
    },
    "federations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WKSF",
          "IKMF",
          "IUKL",
          "IKO",
          "AKLU",
          "BVDKS"
        ]
      }
    },
    "format": {
      "enum": [
        "in-person",
        "online",
        "hybrid"
      ]
    },
    "status": {
      "enum": [
        "confirmed",
        "tentative",
        "postponed",
        "cancelled"
      ]
    },
    "disciplines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registrationUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "registrationDeadline": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "organizerUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeZone": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastChecked": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization",
          "url",
          "checkedAt"
        ],
        "properties": {
          "organization": {
            "enum": [
              "WKSF",
              "IKMF",
              "IUKL",
              "IKO",
              "AKLU",
              "BVDKS"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "checkedAt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "startAt": {
      "type": "string",
      "minLength": 1
    },
    "endAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
